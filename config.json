{
    "ModulesDlls": [
        "[root]/Module1/bin/Debug/net9.0/Module1.dll",
        "[root]/Module2/bin/Debug/net9.0/Module2.dll",
        "[root]/Modules.USB/bin/Debug/net9.0/Modules.USB.dll"
    ],
    "StartupModules": [
        {
            "ModuleName": "Module1",
            "Path": "/modules/mod1",
            "StartOnBoot": true,
            "startAfter": "kernel",
            "hostingChannels": [
                {
                    "Path": "/test",
                    "Name": "#test",
                    "HighData": true
                }
            ]
        },
        {
            "ModuleName": "Module2",
            "Path": "/modules/mod2",
            "StartOnBoot": true,
            "startAfter": "/modules/mod1"
        },
      
        {
            "ModuleName": "USBController",
            "Path": "/modules/USBController",
            "StartOnBoot": true,
            "startAfter": "kernel"
        }
    ]
}